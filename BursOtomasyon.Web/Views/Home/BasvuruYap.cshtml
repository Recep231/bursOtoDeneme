                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    currentHighlight = currentHighlight <= 0 ? visibleOptions.length - 1 : currentHighlight - 1;
                    highlightOption(currentHighlight);
                    visibleOptions[currentHighlight].scrollIntoView({ block: 'nearest' });
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (currentHighlight >= 0 && visibleOptions[currentHighlight]) {
                        visibleOptions[currentHighlight].click();
                    }
                } else if (e.key === 'Escape') {
                    dropdown.classList.remove('show');
                    toggle.classList.remove('rotated');
                    currentHighlight = -1;
                }
            });
            
            document.addEventListener('click', function(e) {
                if (!input.contains(e.target) && !dropdown.contains(e.target) && !toggle.contains(e.target)) {
                    dropdown.classList.remove('show');
                    toggle.classList.remove('rotated');
                    currentHighlight = -1;
                }
            });
            
            function filterOptions() {
                const searchTerm = input.value.toLowerCase();
                let visibleCount = 0;
                
                options.forEach(function(option) {
                    const text = option.textContent.toLowerCase();
                    if (text.includes(searchTerm)) {
                        option.style.display = 'block';
                        visibleCount++;
                    } else {
                        option.style.display = 'none';
                    }
                });
                
                if (visibleCount === 0 && searchTerm === '') {
                    options.forEach(function(option) {
                        option.style.display = 'block';
                    });
                }
            }
            
            function highlightOption(index) {
                const visibleOptions = Array.from(options).filter(opt => opt.style.display !== 'none');
                visibleOptions.forEach(function(opt, i) {
                    if (i === index) {
                        opt.classList.add('highlight');
                    } else {
                        opt.classList.remove('highlight');
                    }
                });
            }
        })();

        // Telefon Numarası Formatlama - Basit ve Güvenilir Versiyon
        (function() {
            const telefonInput = document.getElementById('telefonInput');
            
            if (telefonInput) {
                function formatPhone(numbers) {
                    if (!numbers || numbers.length === 0) return '';
                    
                    // Maksimum 11 rakam (zaten input event'inde kontrol ediliyor)
                    let formatted = '';
                    if (numbers.length > 0) {
                        formatted = numbers.charAt(0); // 0
                        if (numbers.length > 1) {
                            formatted += ' (' + numbers.substring(1, Math.min(4, numbers.length)); // (5XX
                            if (numbers.length > 4) {
                                formatted += ') ' + numbers.substring(4, Math.min(7, numbers.length)); // ) XXX
                                if (numbers.length > 7) {
                                    formatted += ' ' + numbers.substring(7, Math.min(9, numbers.length)); // XX
                                    if (numbers.length > 9) {
                                        // Son 2 rakamı al (9. indeksten sonrası = 10. ve 11. rakamlar)
                                        formatted += ' ' + numbers.substring(9, Math.min(11, numbers.length)); // XX
                                    }
                                }
                            } else if (numbers.length > 1) {
                                formatted += ')';
                            }
                        }
                    }
                    return formatted;
                }
                
                function getDigitCountBeforePosition(value, position) {
                    let count = 0;
                    for (let i = 0; i < position && i < value.length; i++) {
                        if (/\d/.test(value[i])) {
                            count++;
                        }
                    }
                    return count;
                }
                
                function getPositionAfterDigitCount(formatted, digitCount) {
                    let count = 0;
                    for (let i = 0; i < formatted.length; i++) {
                        if (/\d/.test(formatted[i])) {
                            count++;
                            if (count === digitCount) {
                                return i + 1;
                            }
                        }
                    }
                    return formatted.length;
                }
                
                telefonInput.addEventListener('input', function(e) {
                    const oldValue = this.value;
                    const oldCursor = this.selectionStart;
                    
                    // Sadece rakamları al
                    let numbers = this.value.replace(/\D/g, '');
                    
                    // Maksimum 11 rakam (manuel kontrol)
                    if (numbers.length > 11) {
                        numbers = numbers.substring(0, 11);
                    }
                    
                    // Formatla
                    const formatted = formatPhone(numbers);
                    this.value = formatted;
                    
                    // Cursor pozisyonunu ayarla
                    const digitsBeforeCursor = getDigitCountBeforePosition(oldValue, oldCursor);
                    let newCursor = getPositionAfterDigitCount(formatted, digitsBeforeCursor);
                    
                    // Eğer yeni rakam eklendiyse, cursor'ü bir sonraki pozisyona al
                    const oldNumbers = oldValue.replace(/\D/g, '');
                    if (numbers.length > oldNumbers.length) {
                        newCursor = getPositionAfterDigitCount(formatted, numbers.length);
                    }
                    
                    this.setSelectionRange(newCursor, newCursor);
                });
                
                telefonInput.addEventListener('keydown', function(e) {
                    const cursorPos = this.selectionStart;
                    const value = this.value;
                    const numbers = value.replace(/\D/g, '');
                    
                    // Backspace tuşu
                    if (e.key === 'Backspace') {
                        const digitsBeforeCursor = getDigitCountBeforePosition(value, cursorPos);
                        
                        // Eğer format karakterindeyse veya rakam varsa
                        if (cursorPos > 0 && digitsBeforeCursor > 0) {
                            // Önceki rakamı sil
                            const newNumbers = numbers.substring(0, digitsBeforeCursor - 1) + numbers.substring(digitsBeforeCursor);
                            const formatted = formatPhone(newNumbers);
                            this.value = formatted;
                            
                            // Cursor'ü ayarla
                            const newCursor = getPositionAfterDigitCount(formatted, digitsBeforeCursor - 1);
                            this.setSelectionRange(newCursor, newCursor);
                            e.preventDefault();
                        }
                    }
                    
                    // Delete tuşu
                    if (e.key === 'Delete') {
                        const digitsBeforeCursor = getDigitCountBeforePosition(value, cursorPos);
                        
                        // Eğer rakam varsa
                        if (digitsBeforeCursor < numbers.length) {
                            // Sonraki rakamı sil
                            const newNumbers = numbers.substring(0, digitsBeforeCursor) + numbers.substring(digitsBeforeCursor + 1);
                            const formatted = formatPhone(newNumbers);
                            this.value = formatted;
                            
                            // Cursor'ü ayarla
                            const newCursor = getPositionAfterDigitCount(formatted, digitsBeforeCursor);
                            this.setSelectionRange(newCursor, newCursor);
                            e.preventDefault();
                        }
                    }
                    
                    // Sadece rakam, backspace, delete, tab, arrow keys ve home/end tuşlarına izin ver
                    const allowedKeys = ['Backspace', 'Delete', 'Tab', 'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End'];
                    const isNumber = (e.key >= '0' && e.key <= '9');
                    const isAllowed = allowedKeys.includes(e.key) || (e.ctrlKey && ['a', 'c', 'v', 'x'].includes(e.key.toLowerCase()));
                    
                    if (!isNumber && !isAllowed) {
                        e.preventDefault();
                    }
                });
                
                telefonInput.addEventListener('paste', function(e) {
                    e.preventDefault();
                    const pastedText = (e.clipboardData || window.clipboardData).getData('text');
                    const numbers = pastedText.replace(/\D/g, '').substring(0, 11);
                    const formatted = formatPhone(numbers);
                    this.value = formatted;
                    this.setSelectionRange(formatted.length, formatted.length);
                });
            }
        })();
    </script>
</body>
