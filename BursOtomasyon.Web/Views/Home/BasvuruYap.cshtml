                    });
                }
            }
            
            function highlightOption(index) {
                const visibleOptions = Array.from(options).filter(opt => opt.style.display !== 'none');
                visibleOptions.forEach(function(opt, i) {
                    if (i === index) {
                        opt.classList.add('highlight');
                    } else {
                        opt.classList.remove('highlight');
                    }
                });
            }
        })();

        // Bölüm Dropdown
        (function() {
            const input = document.getElementById('bolumInput');
            const dropdown = document.getElementById('bolumDropdown');
            const toggle = document.getElementById('bolumDropdownToggle');
            const options = dropdown.querySelectorAll('.universite-option');
            let currentHighlight = -1;
            
            toggle.addEventListener('click', function(e) {
                e.stopPropagation();
                dropdown.classList.toggle('show');
                toggle.classList.toggle('rotated');
            });
            
            input.addEventListener('focus', function() {
