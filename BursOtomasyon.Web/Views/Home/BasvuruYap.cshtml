@model BursOtomasyon.Web.Models.BasvuruViewModel
@{
    ViewData["Title"] = "Burs Başvuru Formu";
}

<!DOCTYPE html>
<html class="light" lang="tr">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>🎓 Burs Otomasyonu</title>
    <link href="https://fonts.googleapis.com" rel="preconnect"/>
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#4A00E0",
                        "secondary": "#8E2DE2",
                        "accent": "#C06FEF",
                        "holographic-start": "#ff00cc",
                        "holographic-end": "#333399",
                    },
                    fontFamily: {
                        "display": ["Lexend", "sans-serif"],
                        "input": ["Segoe UI", "sans-serif"],
                    },
                    borderRadius: {"DEFAULT": "0.5rem", "lg": "1rem", "xl": "1.5rem", "2xl": "2rem", "full": "9999px"},
                    animation: {
                        'float': 'float 6s ease-in-out infinite',
                        'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'gradient-x': 'gradient-x 15s ease infinite',
                        'pop-in': 'pop-in 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards',
                        'shimmer': 'shimmer 2s linear infinite',
                        'liquid-flow': 'liquidFlow 8s ease-in-out infinite alternate',
                        'galaxy-burst': 'galaxyBurst 0.8s ease-out forwards',
                        'neon-error': 'neonError 0.5s ease-in-out 3',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-10px)' },
                        },
                        'gradient-x': {
                            '0%, 100%': {
                                'background-size': '200% 200%',
                                'background-position': 'left center'
                            },
                            '50%': {
                                'background-size': '200% 200%',
                                'background-position': 'right center'
                            },
                        },
                        'pop-in': {
                            '0%': { opacity: '0', transform: 'scale(0.8)' },
                            '100%': { opacity: '1', transform: 'scale(1)' },
                        },
                        'shimmer': {
                            'from': { backgroundPosition: '0 0' },
                            'to': { backgroundPosition: '-200% 0' }
                        },
                        liquidFlow: {
                             '0%': { backgroundPosition: '0% 50%' },
                             '100%': { backgroundPosition: '100% 50%' }
                        },
                        galaxyBurst: {
                            '0%': { transform: 'scale(0) rotate(0deg)', opacity: '0' },
                            '50%': { opacity: '1' },
                            '100%': { transform: 'scale(1.5) rotate(180deg)', opacity: '0' }
                        },
                        neonError: {
                            '0%, 100%': { boxShadow: '0 0 10px #ff0000, 0 0 20px #ff0000' },
                            '50%': { boxShadow: '0 0 20px #ff0000, 0 0 40px #ff0000' }
                        }
                    }
                },
            },
        }
    </script>
    <style>
        .gradient-bg {
            background: linear-gradient(-45deg, #0f0c29, #302b63, #24243e, #4A00E0);
            background-size: 400% 400%;
            animation: gradient-bg-anim 15s ease infinite
        }
        @@keyframes gradient-bg-anim {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .neo-glass-panel {
            background: rgba(255, 255, 255, 0.65);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-top: 1px solid rgba(255, 255, 255, 0.8);
            border-left: 1px solid rgba(255, 255, 255, 0.8);
            border-radius: 24px;
            box-shadow: 20px 20px 50px rgba(0,0,0,0.1), 
                        -5px -5px 30px rgba(255,255,255,0.8) inset;
            transform-style: preserve-3d;
            perspective: 1000px;
        }
        .liquid-input {
            background: rgba(255, 255, 255, 0.4);
            border: 2px solid transparent;
            transition: all 0.4s ease;
        }
        .liquid-input:hover, .liquid-input:focus {
            background: rgba(255, 255, 255, 0.8);
            border-image: linear-gradient(45deg, #4A00E0, #8E2DE2, #C06FEF) 1;
            box-shadow: 0 0 15px rgba(142, 45, 226, 0.2);
        }
        .ai-pattern-bg:focus {
            background-image: radial-gradient(#4A00E0 0.5px, transparent 0.5px), radial-gradient(#8E2DE2 0.5px, #ffffff 0.5px);
            background-size: 20px 20px;
            background-position: 0 0, 10px 10px;
            background-color: rgba(255,255,255,0.9);
        }
        .holo-checkbox:checked {
            background-image: linear-gradient(135deg, #4A00E0, #C06FEF);
            border-color: transparent;
        }
        .progress-liquid {
            background: linear-gradient(90deg, #4A00E0, #8E2DE2, #C06FEF, #4A00E0);
            background-size: 200% 100%;
            animation: liquid-flow 2s linear infinite;
        }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.1); }
        ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.3); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.5); }
        .section-divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(74, 0, 224, 0.2), transparent);
            margin: 3rem 0;
            position: relative;
        }
        .section-divider::after {
            content: '';
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            width: 8px;
            height: 8px;
            background: #C06FEF;
            border-radius: 50%;
            box-shadow: 0 0 10px #C06FEF;
        }
    </style>
</head>
<body class="font-display antialiased text-gray-800 gradient-bg min-h-screen flex flex-col overflow-x-hidden selection:bg-purple-200 selection:text-purple-900">
<div class="fixed top-20 left-10 w-96 h-96 bg-purple-500 rounded-full mix-blend-overlay filter blur-[100px] opacity-40 animate-float pointer-events-none"></div>
<div class="fixed top-1/2 right-10 w-80 h-80 bg-blue-500 rounded-full mix-blend-overlay filter blur-[90px] opacity-40 animate-blob animation-delay-2000 pointer-events-none"></div>
<div class="fixed -bottom-8 left-1/3 w-96 h-96 bg-pink-500 rounded-full mix-blend-overlay filter blur-[100px] opacity-40 animate-blob animation-delay-4000 pointer-events-none"></div>
<nav class="w-full bg-white/5 backdrop-blur-xl border-b border-white/10 px-6 py-4 sticky top-0 z-50 shadow-[0_4px_30px_rgba(0,0,0,0.1)] transition-all duration-300">
<div class="max-w-[1280px] mx-auto flex items-center justify-between">
<div class="flex items-center gap-3 group cursor-pointer">
<div class="size-10 rounded-xl bg-gradient-to-br from-[#4A00E0] to-[#8E2DE2] text-white flex items-center justify-center shadow-lg group-hover:shadow-purple-400/50 group-hover:scale-110 transition-all duration-300">
<span class="material-symbols-outlined text-[24px]">school</span>
</div>
<h2 class="text-white text-lg md:text-xl font-bold tracking-tight drop-shadow-md">Burs Otomasyonu</h2>
</div>
<div class="hidden md:flex items-center gap-8">
<a class="text-white/80 hover:text-white transition-colors text-sm font-medium relative group" href="/">Ana Sayfa</a>
<a class="text-white text-sm font-bold bg-white/20 border border-white/30 px-3 py-1 rounded-full backdrop-blur-sm" href="/Home/Burslar">Burslar</a>
<a class="text-white/80 hover:text-white transition-colors text-sm font-medium relative group" href="/Bagis/BagisYap">Bağışçılar</a>
<div class="flex gap-3">
<button class="flex items-center justify-center rounded-xl h-9 px-4 bg-white/10 text-white border border-white/30 hover:bg-white/20 text-sm font-bold transition-all shadow-sm backdrop-blur-sm">Giriş</button>
<button class="flex items-center justify-center rounded-xl h-9 px-4 bg-white text-[#4A00E0] hover:bg-gray-100 text-sm font-bold transition-all shadow-md hover:shadow-lg">Kayıt Ol</button>
</div>
</div>
</div>
</nav>
<main class="flex-grow flex items-center justify-center p-4 md:p-8 lg:p-12 relative z-10">
<div class="neo-glass-panel w-full max-w-4xl p-8 md:p-12 flex flex-col gap-6 my-4 relative animate-pop-in">
@if (ViewBag.Success != null && ViewBag.Success)
{
    <div class="absolute inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm rounded-[24px]" id="galaxy-success">
        <div class="text-center relative">
            <div class="absolute inset-0 bg-gradient-to-r from-purple-500 via-pink-500 to-yellow-500 blur-3xl opacity-50 animate-pulse"></div>
            <span class="material-symbols-outlined text-9xl text-white drop-shadow-[0_0_15px_rgba(255,255,255,0.8)] animate-bounce relative z-10">verified</span>
            <h2 class="text-4xl font-black text-white mt-4 relative z-10 drop-shadow-lg">Başvurunuz Başarıyla Alındı!</h2>
            <p class="text-white/80 mt-2 relative z-10">@ViewBag.Message</p>
        </div>
    </div>
}

@if (ViewBag.Error != null)
{
    <div class="absolute top-6 right-6 bg-red-500/90 border border-red-400 text-white px-6 py-4 rounded-2xl backdrop-blur-md z-50 shadow-[0_0_20px_rgba(239,68,68,0.6)] animate-pulse" role="alert">
        <div class="flex items-center gap-4">
            <span class="material-symbols-outlined text-white text-3xl">error</span>
            <div>
                <strong class="font-bold block text-lg">Dikkat!</strong>
                <span class="text-sm opacity-90">@ViewBag.Error</span>
            </div>
        </div>
    </div>
}

<div class="text-center space-y-2 pb-6 border-b border-white/30">
<h1 class="text-3xl md:text-5xl font-black bg-clip-text text-transparent bg-gradient-to-r from-[#4A00E0] via-[#8E2DE2] to-[#C06FEF] tracking-tight pb-1 drop-shadow-sm">Burs Başvuru Formu</h1>
<p class="text-gray-600 font-medium">Tüm bilgileri eksiksiz doldurarak hayallerine ulaş.</p>
</div>
<form asp-action="BasvuruYap" method="post" enctype="multipart/form-data" class="space-y-8" id="bursForm">
<div>
<h3 class="flex items-center gap-3 text-xl font-bold text-[#4A00E0] mb-6">
<span class="material-symbols-outlined bg-purple-100 p-2 rounded-lg shadow-sm">face</span>
                        Kişisel Bilgiler &amp; Fotoğraf
                    </h3>
<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-6">
<div class="col-span-1 flex flex-col items-center justify-start space-y-4 relative">
<label class="text-sm font-bold text-gray-700 w-full text-left ml-1">Profil Fotoğrafı *</label>
<div class="relative group/upload w-full aspect-square max-w-[200px]">
<div class="w-full h-full rounded-full border-2 border-dashed border-[#4A00E0] bg-white/40 flex items-center justify-center cursor-pointer hover:bg-white/60 transition-all shadow-inner overflow-hidden relative" id="photo-preview-container">
<div class="text-center p-4">
<span class="material-symbols-outlined text-4xl text-[#4A00E0] group-hover/upload:scale-110 transition-transform mb-2">add_a_photo</span>
<p class="text-xs text-gray-500 font-medium">Sürükle &amp; Bırak</p>
</div>
<img class="absolute inset-0 w-full h-full object-cover hidden" id="photo-preview-img"/>
<div class="absolute inset-0 hidden bg-white/80 flex items-center justify-center backdrop-blur-[2px]" id="photo-loading">
<svg class="animate-spin h-10 w-10 text-purple-600" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
<path class="opacity-75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z" fill="currentColor"></path>
</svg>
</div>
</div>
<input asp-for="ProfilFoto" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" id="file-upload" type="file"/>
<div class="hidden absolute -bottom-4 left-1/2 -translate-x-1/2 bg-emerald-100 text-emerald-700 px-3 py-1 rounded-full text-xs font-bold shadow-sm whitespace-nowrap animate-pop-in items-center gap-1" id="upload-success-msg">
<span class="material-symbols-outlined text-sm">check_circle</span>
                                    Yüklendi!
                                </div>
</div>
</div>
<div class="col-span-1 md:col-span-2 space-y-6">
<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
<div class="space-y-1">
<label class="text-xs font-bold text-gray-500 uppercase tracking-wide ml-1" asp-for="Ad">Ad *</label>
<input asp-for="Ad" class="w-full rounded-xl liquid-input h-12 px-4 shadow-sm text-base bg-white/50 backdrop-blur-sm focus:ring-0" placeholder="Adın" type="text" required />
<span asp-validation-for="Ad" class="text-red-500 text-sm"></span>
</div>
<div class="space-y-1">
<label class="text-xs font-bold text-gray-500 uppercase tracking-wide ml-1" asp-for="Soyad">Soyad *</label>
<input asp-for="Soyad" class="w-full rounded-xl liquid-input h-12 px-4 shadow-sm text-base bg-white/50 backdrop-blur-sm focus:ring-0" placeholder="Soyadın" type="text" required />
<span asp-validation-for="Soyad" class="text-red-500 text-sm"></span>
</div>
</div>
<div class="space-y-1">
<label class="text-xs font-bold text-gray-500 uppercase tracking-wide ml-1" asp-for="TC">TC Kimlik No *</label>
<input asp-for="TC" class="w-full rounded-xl liquid-input h-12 px-4 shadow-sm text-base bg-white/50 backdrop-blur-sm focus:ring-0 tracking-wider font-mono" maxlength="11" placeholder="___________" type="text" required />
<span asp-validation-for="TC" class="text-red-500 text-sm"></span>
</div>
<div class="space-y-1">
<label class="text-xs font-bold text-gray-500 uppercase tracking-wide ml-1" asp-for="DogumTarihi">Doğum Tarihi *</label>
<input asp-for="DogumTarihi" class="w-full rounded-xl liquid-input h-12 px-4 shadow-sm text-base bg-white/50 backdrop-blur-sm focus:ring-0" type="date" required />
<span asp-validation-for="DogumTarihi" class="text-red-500 text-sm"></span>
</div>
</div>
</div>
</div>
<div class="section-divider"></div>
<div>
<h3 class="flex items-center gap-3 text-xl font-bold text-[#8E2DE2] mb-6">
<span class="material-symbols-outlined bg-purple-100 p-2 rounded-lg shadow-sm">contact_mail</span>
                        İletişim Bilgileri
                    </h3>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<div class="space-y-1">
<label class="text-xs font-bold text-gray-500 uppercase tracking-wide ml-1" asp-for="Email">E-posta *</label>
<div class="relative">
<span class="absolute left-4 top-3 text-gray-400 material-symbols-outlined text-[20px]">alternate_email</span>
<input asp-for="Email" class="w-full rounded-xl liquid-input h-12 pl-12 pr-4 shadow-sm text-base bg-white/50 backdrop-blur-sm focus:ring-0" placeholder="iletisim@mail.com" type="email" required />
</div>
<span asp-validation-for="Email" class="text-red-500 text-sm"></span>
</div>
<div class="space-y-1">
<label class="text-xs font-bold text-gray-500 uppercase tracking-wide ml-1" asp-for="Telefon">Telefon *</label>
<div class="relative">
<span class="absolute left-4 top-3 text-gray-400 material-symbols-outlined text-[20px]">phone_iphone</span>
<input asp-for="Telefon" class="w-full rounded-xl liquid-input h-12 pl-12 pr-4 shadow-sm text-base bg-white/50 backdrop-blur-sm focus:ring-0" placeholder="(5XX) ..." type="tel"/>
</div>
<span asp-validation-for="Telefon" class="text-red-500 text-sm"></span>
</div>
<div class="space-y-1 md:col-span-2">
<label class="text-xs font-bold text-gray-500 uppercase tracking-wide ml-1">Açık Adres</label>
<textarea class="w-full rounded-xl liquid-input p-4 shadow-sm text-base bg-white/50 backdrop-blur-sm focus:ring-0 resize-none" placeholder="Mahalle, Sokak, No..." rows="2"></textarea>
</div>
</div>
</div>
<div class="section-divider"></div>
<div>
<h3 class="flex items-center gap-3 text-xl font-bold text-[#C06FEF] mb-6">
<span class="material-symbols-outlined bg-purple-100 p-2 rounded-lg shadow-sm">school</span>
                        Akademik Bilgiler
                    </h3>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<div class="space-y-1 md:col-span-2">
<label class="text-xs font-bold text-gray-500 uppercase tracking-wide ml-1" asp-for="Universite">Üniversite *</label>
<div class="relative group">
<input asp-for="Universite" class="w-full rounded-xl liquid-input h-12 px-4 shadow-sm text-base bg-white/50 backdrop-blur-sm focus:ring-0" list="universities" placeholder="Üniversite ara..." required />
<span class="absolute right-4 top-3 text-gray-400 group-hover:text-[#8E2DE2] transition-colors material-symbols-outlined">search</span>
<datalist id="universities">
@if (ViewBag.UniversiteListesi != null)
{
    @foreach (var uni in (List<string>)ViewBag.UniversiteListesi)
    {
        <option value="@uni">@uni</option>
    }
}
</datalist>
</div>
<span asp-validation-for="Universite" class="text-red-500 text-sm"></span>
</div>
<div class="space-y-1">
<label class="text-xs font-bold text-gray-500 uppercase tracking-wide ml-1" asp-for="Fakulte">Fakülte *</label>
<div class="relative group">
<input asp-for="Fakulte" class="w-full rounded-xl liquid-input h-12 px-4 shadow-sm text-base bg-white/50 backdrop-blur-sm focus:ring-0" list="faculties" placeholder="Seçiniz..." required />
<span class="absolute right-4 top-3 text-gray-400 group-hover:text-[#8E2DE2] transition-colors material-symbols-outlined">domain</span>
<datalist id="faculties">
@if (ViewBag.FakulteListesi != null)
{
    @foreach (var fak in (List<string>)ViewBag.FakulteListesi)
    {
        <option value="@fak">@fak</option>
    }
}
</datalist>
</div>
<span asp-validation-for="Fakulte" class="text-red-500 text-sm"></span>
</div>
<div class="space-y-1">
<label class="text-xs font-bold text-gray-500 uppercase tracking-wide ml-1" asp-for="Bolum">Bölüm *</label>
<div class="relative group">
<input asp-for="Bolum" class="w-full rounded-xl liquid-input h-12 px-4 shadow-sm text-base bg-white/50 backdrop-blur-sm focus:ring-0" list="departments" placeholder="Seçiniz..." required />
<span class="absolute right-4 top-3 text-gray-400 group-hover:text-[#8E2DE2] transition-colors material-symbols-outlined">menu_book</span>
<datalist id="departments">
@if (ViewBag.BolumListesi != null)
{
    @foreach (var bol in (List<string>)ViewBag.BolumListesi)
    {
        <option value="@bol">@bol</option>
    }
}
</datalist>
</div>
<span asp-validation-for="Bolum" class="text-red-500 text-sm"></span>
</div>
<div class="space-y-1">
<label class="text-xs font-bold text-gray-500 uppercase tracking-wide ml-1" asp-for="Sinif">Sınıf *</label>
<select asp-for="Sinif" class="w-full rounded-xl liquid-input h-12 px-4 shadow-sm text-base bg-white/50 backdrop-blur-sm focus:ring-0 cursor-pointer text-gray-700" required>
<option disabled selected value="">Seçiniz</option>
<option value="Hazırlık">Hazırlık</option>
<option value="1">1. Sınıf</option>
<option value="2">2. Sınıf</option>
<option value="3">3. Sınıf</option>
<option value="4">4. Sınıf</option>
</select>
<span asp-validation-for="Sinif" class="text-red-500 text-sm"></span>
</div>
<div class="space-y-1">
<label class="text-xs font-bold text-gray-500 uppercase tracking-wide ml-1" asp-for="NotOrtalamasi">GNO *</label>
<input asp-for="NotOrtalamasi" class="w-full rounded-xl liquid-input h-12 px-4 shadow-sm text-base bg-white/50 backdrop-blur-sm focus:ring-0 font-mono text-[#4A00E0] font-bold" max="4" min="0" placeholder="0.00" step="0.01" type="number" required />
<span asp-validation-for="NotOrtalamasi" class="text-red-500 text-sm"></span>
</div>
</div>
</div>
<div class="section-divider"></div>
<div>
<h3 class="flex items-center gap-3 text-xl font-bold text-[#8E2DE2] mb-6">
<span class="material-symbols-outlined bg-purple-100 p-2 rounded-lg shadow-sm">family_restroom</span>
                        Aile Bilgileri
                    </h3>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<div class="space-y-1">
<label class="text-xs font-bold text-gray-500 uppercase tracking-wide ml-1" asp-for="BabaMeslek">Baba Mesleği *</label>
<input asp-for="BabaMeslek" class="w-full rounded-xl liquid-input h-12 px-4 shadow-sm text-base bg-white/50 backdrop-blur-sm focus:ring-0" placeholder="Baba mesleği" type="text"/>
</div>
<div class="space-y-1">
<label class="text-xs font-bold text-gray-500 uppercase tracking-wide ml-1" asp-for="AnneMeslek">Anne Mesleği *</label>
<input asp-for="AnneMeslek" class="w-full rounded-xl liquid-input h-12 px-4 shadow-sm text-base bg-white/50 backdrop-blur-sm focus:ring-0" placeholder="Anne mesleği" type="text"/>
</div>
<div class="space-y-1 md:col-span-2">
<label class="text-xs font-bold text-gray-500 uppercase tracking-wide ml-1" asp-for="AileGeliri">Ailenin Aylık Geliri *</label>
<div class="relative">
<span class="absolute left-4 top-3 text-gray-400 font-bold">₺</span>
<input asp-for="AileGeliri" type="number" min="0" step="0.01" class="w-full rounded-xl liquid-input h-12 pl-10 pr-4 shadow-sm text-base bg-white/50 backdrop-blur-sm focus:ring-0 cursor-pointer text-gray-700" placeholder="Örn: 55000" required />
</div>
<span asp-validation-for="AileGeliri" class="text-red-500 text-sm"></span>
</div>
</div>
</div>
<div class="section-divider"></div>
<div>
<h3 class="flex items-center gap-3 text-xl font-bold text-[#4A00E0] mb-6">
<span class="material-symbols-outlined bg-purple-100 p-2 rounded-lg shadow-sm">psychology</span>
                        Klasik Sorular
                    </h3>
<div class="space-y-6">
<div class="space-y-2">
