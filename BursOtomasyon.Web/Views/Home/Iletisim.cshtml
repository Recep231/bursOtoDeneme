@{
    ViewData["Title"] = "İletişim";
}

<!DOCTYPE html>
<html class="light" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>🎓 Burs Otomasyonu - İletişim</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800&amp;family=Space+Grotesk:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#4A00E0",
                        "secondary": "#8E2DE2",
                        "accent": "#C06FEF",
                    },
                    fontFamily: {
                        "display": ["Lexend", "sans-serif"],
                        "heading": ["Space Grotesk", "sans-serif"],
                    },
                    borderRadius: {"DEFAULT": "0.5rem", "lg": "1rem", "xl": "1.5rem", "2xl": "2rem", "3xl": "2.5rem", "full": "9999px"},
                    animation: {
                        'float': 'float 6s ease-in-out infinite',
                        'float-delayed': 'float 6s ease-in-out 3s infinite',
                        'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'fade-in-up': 'fadeInUp 0.8s ease-out forwards',
                        'fade-in-up-delay': 'fadeInUp 0.8s ease-out 0.2s forwards',
                        'fade-in-up-delay-2': 'fadeInUp 0.8s ease-out 0.4s forwards',
                        'bounce-slow': 'bounce 3s infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-20px)' },
                        },
                        fadeInUp: {
                            '0%': { opacity: '0', transform: 'translateY(30px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        }
                    }
                },
            },
        }
    </script>
    <style>
        .gradient-bg {
            background: linear-gradient(-45deg, #0f0c29, #302b63, #24243e, #4A00E0);
            background-size: 400% 400%;
            animation: gradient-bg-anim 15s ease infinite
        }
        @@keyframes gradient-bg-anim {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .neo-glass-panel {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-top: 1px solid rgba(255, 255, 255, 0.9);
            border-left: 1px solid rgba(255, 255, 255, 0.9);
            box-shadow: 20px 20px 60px rgba(0,0,0,0.1), 
                        -5px -5px 30px rgba(255,255,255,0.8) inset;
        }
        .text-gradient {
            background: linear-gradient(135deg, #4A00E0 0%, #8E2DE2 50%, #C06FEF 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .contact-card {
            transition: all 0.3s ease;
        }
        .contact-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 15px 40px rgba(74, 0, 224, 0.2);
            background: rgba(255, 255, 255, 0.85);
        }
        .input-glass {
            background: rgba(255, 255, 255, 0.4);
            backdrop-filter: blur(12px);
            border: 2px solid rgba(255, 255, 255, 0.3);
            transition: all 0.3s ease;
        }
        .input-glass:focus {
            background: rgba(255, 255, 255, 0.7);
            border-color: rgba(74, 0, 224, 0.5);
            box-shadow: 0 0 20px rgba(74, 0, 224, 0.15);
            outline: none;
        }
        .blob-bg {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.6;
            z-index: 0;
        }
    </style>
</head>
<body class="font-display antialiased text-gray-800 gradient-bg min-h-screen flex flex-col overflow-x-hidden selection:bg-purple-200 selection:text-purple-900">
    <div class="fixed top-0 left-0 w-full h-full overflow-hidden pointer-events-none z-0">
        <div class="blob-bg bg-purple-500 w-[500px] h-[500px] top-[-100px] left-[-100px] animate-pulse-slow"></div>
        <div class="blob-bg bg-blue-500 w-[400px] h-[400px] top-[40%] right-[-100px] animate-pulse-slow animation-delay-2000"></div>
        <div class="blob-bg bg-pink-500 w-[600px] h-[600px] bottom-[-200px] left-[30%] animate-pulse-slow animation-delay-4000"></div>
    </div>

    <nav class="w-full bg-white/5 backdrop-blur-xl border-b border-white/10 px-6 py-4 sticky top-0 z-50 shadow-[0_4px_30px_rgba(0,0,0,0.1)] transition-all duration-300">
        <div class="max-w-[1280px] mx-auto flex items-center justify-between">
            <a href="/" class="flex items-center gap-3 group cursor-pointer">
                <div class="size-10 rounded-xl bg-gradient-to-br from-[#4A00E0] to-[#8E2DE2] text-white flex items-center justify-center shadow-lg group-hover:shadow-purple-400/50 group-hover:scale-110 transition-all duration-300">
                    <span class="material-symbols-outlined text-[24px]">school</span>
                </div>
                <h2 class="text-white text-lg md:text-xl font-bold tracking-tight drop-shadow-md">Burs Otomasyonu</h2>
            </a>
            <div class="hidden md:flex items-center gap-8">
                <a class="text-white/80 hover:text-white transition-colors text-sm font-medium relative group" href="/">Ana Sayfa</a>
                <a class="text-white/80 hover:text-white transition-colors text-sm font-medium relative group" href="/Home/Burslar">Burslar</a>
                <a class="text-white/80 hover:text-white transition-colors text-sm font-medium relative group" href="/Bagis/BagisYap">Bağışçılar</a>
                <a class="text-white/80 hover:text-white transition-colors text-sm font-medium relative group" href="/Home/Hakkimizda">Hakkımızda</a>
                <a class="text-white text-sm font-bold bg-white/20 border border-white/30 px-3 py-1 rounded-full backdrop-blur-sm shadow-[0_0_15px_rgba(255,255,255,0.3)]" href="/Home/Iletisim">İletişim</a>
                <div class="flex gap-3">
                    <a href="/Home/Giris" class="flex items-center justify-center rounded-xl h-9 px-4 bg-white/10 text-white border border-white/30 hover:bg-white/20 text-sm font-bold transition-all shadow-sm backdrop-blur-sm">Giriş</a>
                    <a href="/Home/BasvuruYap" class="flex items-center justify-center rounded-xl h-9 px-4 bg-white text-[#4A00E0] hover:bg-gray-100 text-sm font-bold transition-all shadow-md hover:shadow-lg">Kayıt Ol</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="flex-grow flex flex-col items-center justify-start p-4 md:p-8 lg:p-12 relative z-10 w-full max-w-[1400px] mx-auto">
        <div class="w-full text-center mb-12 mt-8 animate-fade-in-up">
            <h1 class="text-5xl md:text-7xl font-heading font-black text-white mb-6 drop-shadow-2xl tracking-tighter">
                Bizimle <span class="text-transparent bg-clip-text bg-gradient-to-r from-pink-300 via-purple-300 to-indigo-300">İletişime Geçin</span>
            </h1>
            <p class="text-xl text-white/90 max-w-2xl mx-auto font-light leading-relaxed">
                Sorularınız, önerileriniz veya destek talepleriniz için buradayız. Size en kısa sürede dönüş yapacağız.
            </p>
        </div>

        <div class="w-full grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
            <!-- İletişim Formu -->
            <div class="neo-glass-panel rounded-[40px] p-8 md:p-12 relative overflow-hidden animate-fade-in-up-delay">
                <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-br from-purple-100/40 to-transparent rounded-bl-[100px] -z-10 pointer-events-none"></div>
                <div class="relative z-10">
                    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-100/50 border border-purple-200/50 text-purple-700 text-sm font-bold shadow-sm mb-6">
                        <span class="material-symbols-outlined text-[18px]">mail</span>
                        Mesaj Gönder
                    </div>
                    <h2 class="text-3xl font-heading font-bold text-gray-800 mb-6">
                        Bize <span class="text-gradient">Yazın</span>
                    </h2>
                    <form class="space-y-6" id="contactForm">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-bold text-gray-700 mb-2">Ad Soyad *</label>
                                <input type="text" required class="w-full input-glass rounded-xl h-12 px-4 text-gray-800 placeholder-gray-400" placeholder="Adınız ve Soyadınız" />
                            </div>
                            <div>
                                <label class="block text-sm font-bold text-gray-700 mb-2">E-posta *</label>
                                <input type="email" required class="w-full input-glass rounded-xl h-12 px-4 text-gray-800 placeholder-gray-400" placeholder="ornek@email.com" />
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-2">Konu *</label>
                            <input type="text" required class="w-full input-glass rounded-xl h-12 px-4 text-gray-800 placeholder-gray-400" placeholder="Mesajınızın konusu" />
                        </div>
                        <div>
                            <label class="block text-sm font-bold text-gray-700 mb-2">Mesajınız *</label>
                            <textarea required rows="6" class="w-full input-glass rounded-xl p-4 text-gray-800 placeholder-gray-400 resize-none" placeholder="Mesajınızı buraya yazın..."></textarea>
                        </div>
                        <button type="submit" class="w-full py-4 rounded-xl bg-gradient-to-r from-[#4A00E0] to-[#8E2DE2] text-white font-bold text-lg shadow-lg shadow-purple-500/30 hover:shadow-purple-500/50 hover:scale-105 transition-all flex items-center justify-center gap-2 group">
                            <span>Mesajı Gönder</span>
                            <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">send</span>
                        </button>
                    </form>
                </div>
            </div>

            <!-- İletişim Bilgileri -->
            <div class="space-y-6 animate-fade-in-up-delay-2">
                <div class="neo-glass-panel rounded-[40px] p-8 contact-card">
                    <div class="flex items-start gap-4">
                        <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-2xl flex items-center justify-center text-white shadow-lg shadow-blue-500/30 flex-shrink-0">
                            <span class="material-symbols-outlined text-[32px]">location_on</span>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-gray-800 mb-2">Adres</h3>
                            <p class="text-gray-600 leading-relaxed">
                                Maslak Mahallesi, Büyükdere Caddesi<br />
                                No: 123, Sarıyer<br />
                                İstanbul, Türkiye
                            </p>
                        </div>
                    </div>
                </div>

                <div class="neo-glass-panel rounded-[40px] p-8 contact-card">
                    <div class="flex items-start gap-4">
                        <div class="w-14 h-14 bg-gradient-to-br from-purple-500 to-pink-500 rounded-2xl flex items-center justify-center text-white shadow-lg shadow-purple-500/30 flex-shrink-0">
                            <span class="material-symbols-outlined text-[32px]">call</span>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-gray-800 mb-2">Telefon</h3>
                            <p class="text-gray-600 leading-relaxed">
                                <a href="tel:+902121234567" class="hover:text-purple-600 transition-colors">+90 (212) 123 45 67</a><br />
                                <a href="tel:+905551234567" class="hover:text-purple-600 transition-colors">+90 (555) 123 45 67</a>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="neo-glass-panel rounded-[40px] p-8 contact-card">
                    <div class="flex items-start gap-4">
                        <div class="w-14 h-14 bg-gradient-to-br from-orange-500 to-red-500 rounded-2xl flex items-center justify-center text-white shadow-lg shadow-orange-500/30 flex-shrink-0">
                            <span class="material-symbols-outlined text-[32px]">alternate_email</span>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-gray-800 mb-2">E-posta</h3>
                            <p class="text-gray-600 leading-relaxed">
                                <a href="mailto:info@bursotomasyonu.com" class="hover:text-purple-600 transition-colors">info@bursotomasyonu.com</a><br />
                                <a href="mailto:destek@bursotomasyonu.com" class="hover:text-purple-600 transition-colors">destek@bursotomasyonu.com</a>
                            </p>
                        </div>
                    </div>
                </div>

                <div class="neo-glass-panel rounded-[40px] p-8 contact-card">
                    <div class="flex items-start gap-4">
                        <div class="w-14 h-14 bg-gradient-to-br from-green-500 to-emerald-500 rounded-2xl flex items-center justify-center text-white shadow-lg shadow-green-500/30 flex-shrink-0">
                            <span class="material-symbols-outlined text-[32px]">schedule</span>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-gray-800 mb-2">Çalışma Saatleri</h3>
                            <p class="text-gray-600 leading-relaxed">
                                Pazartesi - Cuma: 09:00 - 18:00<br />
                                Cumartesi: 10:00 - 16:00<br />
                                Pazar: Kapalı
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sosyal Medya -->
        <div class="w-full neo-glass-panel rounded-[40px] p-8 md:p-12 animate-fade-in-up-delay-2">
            <h3 class="text-center text-2xl font-bold text-gray-800 mb-8 flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-purple-600">share</span>
                Sosyal Medyada Bizi Takip Edin
            </h3>
            <div class="flex justify-center gap-4 flex-wrap">
                <a href="#" class="w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl flex items-center justify-center text-white shadow-lg hover:scale-110 hover:shadow-xl transition-all">
                    <span class="material-symbols-outlined text-[32px]">facebook</span>
                </a>
                <a href="#" class="w-16 h-16 bg-gradient-to-br from-pink-500 to-rose-600 rounded-2xl flex items-center justify-center text-white shadow-lg hover:scale-110 hover:shadow-xl transition-all">
                    <span class="material-symbols-outlined text-[32px]">instagram</span>
                </a>
                <a href="#" class="w-16 h-16 bg-gradient-to-br from-blue-400 to-cyan-500 rounded-2xl flex items-center justify-center text-white shadow-lg hover:scale-110 hover:shadow-xl transition-all">
                    <span class="material-symbols-outlined text-[32px]">chat</span>
                </a>
                <a href="#" class="w-16 h-16 bg-gradient-to-br from-gray-700 to-gray-900 rounded-2xl flex items-center justify-center text-white shadow-lg hover:scale-110 hover:shadow-xl transition-all">
                    <span class="material-symbols-outlined text-[32px]">code</span>
                </a>
                <a href="#" class="w-16 h-16 bg-gradient-to-br from-red-500 to-red-600 rounded-2xl flex items-center justify-center text-white shadow-lg hover:scale-110 hover:shadow-xl transition-all">
                    <span class="material-symbols-outlined text-[32px]">videocam</span>
                </a>
            </div>
        </div>
    </main>

    <footer class="bg-black/20 backdrop-blur-md border-t border-white/10 py-8 mt-auto relative z-10 text-white">
        <div class="max-w-[1280px] mx-auto px-8">
            <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                <div class="text-white/70 text-sm font-medium text-center md:text-left">
                    <p class="mb-2">© 2024 Öğrenci Burs Yönetim Sistemi. Tüm hakları saklıdır.</p>
                    <p class="text-xs opacity-60">Gelecek seninle aydınlanacak.</p>
                </div>
                <div class="flex gap-4">
                    <a class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors" href="#">
                        <span class="material-symbols-outlined text-sm">alternate_email</span>
                    </a>
                    <a class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors" href="#">
                        <span class="material-symbols-outlined text-sm">call</span>
                    </a>
                    <a class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors" href="#">
                        <span class="material-symbols-outlined text-sm">location_on</span>
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script>
        document.getElementById('contactForm')?.addEventListener('submit', function(e) {
            e.preventDefault();
            alert('Mesajınız başarıyla gönderildi! En kısa sürede size dönüş yapacağız.');
            this.reset();
        });
    </script>
</body>
</html>

