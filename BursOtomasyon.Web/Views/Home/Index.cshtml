@{
    ViewData["Title"] = "Ana Sayfa";
}

<!DOCTYPE html>
<html class="light" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>🎓 Burs Otomasyonu - Ana Sayfa</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#4A00E0",
                        "secondary": "#8E2DE2",
                        "electric-blue": "#00F0FF",
                        "electric-purple": "#BD00FF",
                        "deep-bg": "#0f0c29",
                    },
                    fontFamily: {
                        "display": ["Outfit", "sans-serif"],
                        "body": ["Plus Jakarta Sans", "sans-serif"],
                    },
                    borderRadius: {"DEFAULT": "0.5rem", "lg": "1rem", "xl": "1.5rem", "2xl": "2rem", "full": "9999px"},
                    animation: {
                        'liquid-bg': 'liquid 20s ease infinite',
                        'float': 'float 6s ease-in-out infinite',
                        'pulse-glow': 'pulse-glow 3s infinite',
                        'glitch-skew': 'glitch-skew 1s infinite linear alternate-reverse',
                        'ripple-text': 'ripple-text 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) both',
                        'icon-3d-spin': 'icon-3d-spin 1.5s ease-in-out infinite',
                        'energy-border': 'energy-border 3s linear infinite',
                        'quantum-wave': 'quantum-wave 8s infinite',
                        'particle-float': 'particle-float 20s linear infinite',
                    },
                    keyframes: {
                        liquid: {
                            '0%': { 'background-position': '0% 50%' },
                            '50%': { 'background-position': '100% 50%' },
                            '100%': { 'background-position': '0% 50%' },
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-20px)' },
                        },
                        'pulse-glow': {
                            '0%, 100%': { opacity: '0.6', transform: 'scale(1)' },
                            '50%': { opacity: '1', transform: 'scale(1.05)' },
                        },
                        'glitch-skew': {
                            '0%': { transform: 'skew(0deg)' },
                            '20%': { transform: 'skew(-2deg)' },
                            '40%': { transform: 'skew(2deg)' },
                            '60%': { transform: 'skew(-1deg)' },
                            '80%': { transform: 'skew(1deg)' },
                            '100%': { transform: 'skew(0deg)' },
                        },
                        'ripple-text': {
                            '0%': { opacity: '0', transform: 'translateY(20px) scale(0.9)' },
                            '100%': { opacity: '1', transform: 'translateY(0) scale(1)' }
                        },
                        'icon-3d-spin': {
                            '0%': { transform: 'rotateY(0deg)' },
                            '100%': { transform: 'rotateY(360deg)' }
                        },
                        'energy-border': {
                            '0%': { backgroundPosition: '0% 0%' },
                            '100%': { backgroundPosition: '200% 0%' }
                        },
                        'quantum-wave': {
                            '0%': { transform: 'scale(0) rotate(0deg)', opacity: '0' },
                            '50%': { opacity: '0.3' },
                            '100%': { transform: 'scale(2) rotate(180deg)', opacity: '0' }
                        },
                        'particle-float': {
                            '0%': { transform: 'translate(0, 0)' },
                            '25%': { transform: 'translate(10px, -15px)' },
                            '50%': { transform: 'translate(-5px, -25px)' },
                            '75%': { transform: 'translate(-15px, -10px)' },
                            '100%': { transform: 'translate(0, 0)' }
                        }
                    }
                },
            },
        }
    </script>
    <style>
        .font-modern {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        h1, h2, h3 {
            font-family: 'Outfit', sans-serif;
        }
        .liquid-bg {
            background: linear-gradient(-45deg, #0f0c29, #302b63, #24243e, #4A00E0, #00F0FF, #8E2DE2);
            background-size: 400% 400%;
        }
        .glass-nav {
            background: rgba(255, 255, 255, 0.01);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }
        .glass-card-modern {
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            position: relative;
            z-index: 1;
            overflow: hidden;
        }
        .holo-pattern {
            position: absolute;
            inset: 0;
            background-image: 
                radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(45deg, transparent 48%, rgba(255, 255, 255, 0.02) 50%, transparent 52%);
            background-size: 20px 20px, 30px 30px;
            opacity: 0.5;
            z-index: -1;
            transition: opacity 0.5s;
        }
        .glass-card-modern:hover .holo-pattern {
            opacity: 0.8;
            animation: particle-float 5s linear infinite;
        }
        .energy-glow::before {
            content: '';
            position: absolute;
            inset: -2px;
            background: linear-gradient(90deg, #00F0FF, #BD00FF, #00F0FF);
            background-size: 200% 100%;
            z-index: -2;
            border-radius: inherit;
            opacity: 0;
            transition: opacity 0.4s ease;
        }
        .glass-card-modern:hover.energy-glow::before {
            opacity: 1;
            animation: energy-border 2s linear infinite;
        }
        .glitch-text {
            position: relative;
            color: white;
            text-shadow: 
                0 0 10px rgba(74, 0, 224, 0.8),
                2px 2px 0px rgba(0, 240, 255, 0.6),
                -1px -1px 0px rgba(189, 0, 255, 0.6);
        }
        .glitch-text::before,
        .glitch-text::after {
            content: attr(data-text);
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #0f0c29;
            opacity: 0.8;
        }
        .glitch-text::before {
            left: 2px;
            text-shadow: -1px 0 #00F0FF;
            clip-path: inset(20% 0 30% 0);
            animation: glitch-skew 2.5s infinite linear alternate-reverse;
            background: transparent;
        }
        .glitch-text::after {
            left: -2px;
            text-shadow: 1px 0 #BD00FF;
            clip-path: inset(60% 0 10% 0);
            animation: glitch-skew 3s infinite linear alternate-reverse;
            background: transparent;
        }
        .text-depth {
            color: #ffffff;
            text-shadow: 
                0 1px 0 #cccccc, 
                0 2px 0 #c9c9c9, 
                0 3px 0 #bbbbbb, 
                0 4px 0 #b9b9b9, 
                0 5px 0 #aaaaaa, 
                0 6px 1px rgba(0,0,0,.1), 
                0 0 5px rgba(0,0,0,.1), 
                0 1px 3px rgba(0,0,0,.3), 
                0 3px 5px rgba(0,0,0,.2), 
                0 5px 10px rgba(0,0,0,.25), 
                0 0 20px rgba(0, 240, 255, 0.5);
        }
        .ripple-word {
            display: inline-block;
            opacity: 0;
            animation: ripple-text 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
        }
        .icon-hover-effect {
            transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .glass-card-modern:hover .icon-hover-effect {
            transform: rotateY(180deg) scale(1.1);
        }
    </style>
</head>
<body class="relative flex min-h-screen w-full flex-col overflow-x-hidden font-modern liquid-bg animate-liquid-bg text-white selection:bg-electric-blue selection:text-black">
    <!-- Floating Particles -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
        <div class="absolute top-[10%] left-[15%] w-1 h-1 bg-white rounded-full opacity-60 animate-particle-float"></div>
        <div class="absolute top-[40%] left-[80%] w-1.5 h-1.5 bg-electric-blue rounded-full opacity-40 animate-particle-float" style="animation-delay: 2s;"></div>
        <div class="absolute top-[70%] left-[20%] w-2 h-2 bg-electric-purple rounded-full opacity-30 animate-particle-float" style="animation-delay: 4s;"></div>
        <div class="absolute top-[20%] right-[10%] w-1 h-1 bg-white rounded-full opacity-50 animate-particle-float" style="animation-delay: 1s;"></div>
        <div class="absolute top-1/4 left-1/4 w-[300px] h-[300px] border border-electric-blue/10 rounded-full animate-quantum-wave"></div>
        <div class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] border border-electric-purple/10 rounded-full animate-quantum-wave" style="animation-delay: 3s;"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-electric-purple/5 rounded-full blur-[100px]"></div>
    </div>

    <!-- Navigation -->
    <nav class="glass-nav w-full absolute top-0 z-50">
        <div class="px-6 md:px-12 py-5 flex items-center justify-between">
            <a href="/" class="flex items-center gap-3 text-white group cursor-pointer">
                <div class="relative size-10 flex items-center justify-center bg-white/5 rounded-xl backdrop-blur-md border border-white/10 shadow-[0_0_15px_rgba(255,255,255,0.1)] transition-all duration-300 group-hover:bg-white/10 group-hover:shadow-[0_0_20px_rgba(0,240,255,0.4)]">
                    <span class="material-symbols-outlined text-white text-[24px] group-hover:animate-spin transition-transform">school</span>
                </div>
                <h2 class="text-white text-xl font-bold tracking-tight hidden sm:block font-display group-hover:text-electric-blue transition-colors">Burs Otomasyonu</h2>
            </a>
            <div class="flex items-center gap-8">
                <div class="hidden md:flex items-center gap-8">
                    <a class="text-white/70 hover:text-electric-blue hover:scale-105 transform text-sm font-semibold transition-all duration-300 relative after:content-[''] after:absolute after:bottom-[-4px] after:left-0 after:w-0 after:h-[2px] after:bg-electric-blue after:transition-all hover:after:w-full" href="/">Ana Sayfa</a>
                    <a class="text-white text-sm font-bold bg-white/20 border border-white/30 px-3 py-1 rounded-full backdrop-blur-sm shadow-[0_0_15px_rgba(255,255,255,0.1)]" href="/Home/Burslar">Burslar</a>
                    <a class="text-white/70 hover:text-electric-blue hover:scale-105 transform text-sm font-semibold transition-all duration-300" href="/Bagis/BagisYap">Bağışçılar</a>
                    <a class="text-white/70 hover:text-electric-blue hover:scale-105 transform text-sm font-semibold transition-all duration-300" href="/Home/Hakkimizda">Hakkımızda</a>
                    <a class="text-white/70 hover:text-electric-blue hover:scale-105 transform text-sm font-semibold transition-all duration-300" href="/Home/Iletisim">İletişim</a>
                </div>
                <div class="flex gap-3">
                    <a class="flex items-center justify-center rounded-xl h-10 px-6 bg-white/10 hover:bg-white/20 text-white text-sm font-bold tracking-wide transition-all border border-white/10 hover:border-electric-blue/50 shadow-lg hover:shadow-[0_0_20px_rgba(0,240,255,0.3)] hover:-translate-y-0.5" href="/Home/Giris">
                        <span>Giriş Yap</span>
                    </a>
                    <a class="flex items-center justify-center rounded-xl h-10 px-6 bg-white hover:bg-gray-100 text-[#4A00E0] text-sm font-bold tracking-wide transition-all shadow-md hover:shadow-lg" href="/Home/BasvuruYap">
                        <span>Kayıt Ol</span>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="relative flex h-full grow flex-col items-center justify-center px-4 py-32 md:py-24">
        <!-- Background Glows -->
        <div class="absolute top-[15%] left-[10%] w-[400px] h-[400px] bg-gradient-to-r from-electric-purple to-secondary rounded-full mix-blend-screen filter blur-[100px] opacity-30 animate-pulse-glow"></div>
        <div class="absolute bottom-[10%] right-[10%] w-[500px] h-[500px] bg-gradient-to-l from-electric-blue to-primary rounded-full mix-blend-screen filter blur-[120px] opacity-30 animate-pulse-glow" style="animation-delay: 2s;"></div>

        <!-- Hero Section -->
        <div class="flex flex-col max-w-[1000px] w-full items-center text-center mb-24 relative z-10">
            <div class="mb-10 inline-flex items-center justify-center rounded-full bg-black/20 px-6 py-2 backdrop-blur-xl border border-white/10 shadow-[0_0_30px_rgba(74,0,224,0.4)] hover:bg-white/5 transition-colors cursor-default animate-fade-in-up" style="animation-delay: 0.1s;">
                <span class="material-symbols-outlined text-electric-blue text-sm mr-2 animate-pulse">verified</span>
                <span class="text-white text-xs font-bold tracking-widest uppercase bg-clip-text text-transparent bg-gradient-to-r from-white to-white/70">Güvenilir Burs Platformu</span>
            </div>
            <h1 class="font-display tracking-tight text-6xl md:text-8xl font-black leading-[1.1] px-4 pb-6 glitch-text" data-text="🎓 Burs Otomasyonu">
                🎓 Burs Otomasyonu
            </h1>
            <p class="text-blue-100/90 text-lg md:text-2xl font-light leading-relaxed max-w-3xl px-4 mt-4 drop-shadow-sm tracking-wide">
                <span class="ripple-word" style="animation-delay: 0.2s">Öğrencilere </span>
                <span class="ripple-word" style="animation-delay: 0.25s">destek </span>
                <span class="ripple-word" style="animation-delay: 0.3s">olmak </span>
                <span class="ripple-word" style="animation-delay: 0.35s">için </span>
                <span class="ripple-word text-electric-blue font-medium" style="animation-delay: 0.4s">bağış </span>
                <span class="ripple-word text-electric-blue font-medium" style="animation-delay: 0.45s">yapabilir </span>
                <span class="ripple-word" style="animation-delay: 0.5s">veya </span>
                <span class="ripple-word text-electric-purple font-medium" style="animation-delay: 0.55s">burs </span>
                <span class="ripple-word text-electric-purple font-medium" style="animation-delay: 0.6s">başvurusunda </span>
                <span class="ripple-word" style="animation-delay: 0.65s">bulunabilirsiniz.</span>
            </p>
        </div>

        <!-- Cards Section -->
        <div class="w-full max-w-[1200px] grid grid-cols-1 md:grid-cols-2 gap-12 px-4 relative z-10 pb-16">
            <!-- Bağış Yap Card -->
            <a class="glass-card-modern energy-glow group relative flex flex-col items-center justify-center p-10 rounded-[2.5rem] transition-all duration-500 transform hover:-translate-y-[15px] hover:shadow-[0_20px_80px_rgba(0,240,255,0.2)] h-96 md:h-[28rem] text-center decoration-none" href="/Bagis/BagisYap">
                <div class="holo-pattern"></div>
                <div class="absolute -top-20 -right-20 w-80 h-80 bg-electric-blue/10 rounded-full blur-[80px] group-hover:scale-150 transition-transform duration-700 ease-in-out"></div>
                <div class="relative z-10 flex flex-col items-center h-full justify-center">
                    <div class="mb-8 p-6 bg-gradient-to-b from-white/10 to-transparent rounded-2xl backdrop-blur-md shadow-2xl border border-white/20 group-hover:border-electric-blue/50 ring-1 ring-white/10 group-hover:ring-electric-blue/30 transition-all duration-500 group-hover:scale-110">
                        <span class="material-symbols-outlined text-electric-blue text-[64px] icon-hover-effect drop-shadow-[0_0_15px_rgba(0,240,255,0.6)]">volunteer_activism</span>
                    </div>
                    <h3 class="text-white text-4xl md:text-5xl font-bold mb-4 tracking-tight drop-shadow-xl font-display group-hover:text-electric-blue transition-colors duration-300">Bağış Yap</h3>
                    <p class="text-white/70 text-lg font-normal mb-8 group-hover:text-white/90 transition-colors">Geleceğe ışık tutun.</p>
                    <div class="flex items-center gap-2 text-white font-bold text-sm bg-white/5 px-8 py-4 rounded-xl backdrop-blur-md border border-white/10 group-hover:bg-electric-blue group-hover:text-black group-hover:border-electric-blue transition-all duration-300 shadow-lg">
                        <span>Hemen Başla</span>
                        <span class="material-symbols-outlined text-lg group-hover:translate-x-1 transition-transform">arrow_forward</span>
                    </div>
                </div>
            </a>

            <!-- Burs Başvurusu Card -->
            <a class="glass-card-modern energy-glow group relative flex flex-col items-center justify-center p-10 rounded-[2.5rem] transition-all duration-500 transform hover:-translate-y-[15px] hover:shadow-[0_20px_80px_rgba(189,0,255,0.2)] h-96 md:h-[28rem] text-center decoration-none" href="/Home/BasvuruYap">
                <div class="holo-pattern"></div>
                <div class="absolute top-10 left-10 w-64 h-64 bg-electric-purple/10 rounded-full blur-[80px] group-hover:translate-x-10 transition-transform duration-700 ease-in-out"></div>
                <div class="relative z-10 flex flex-col items-center h-full justify-center">
                    <div class="mb-8 p-6 bg-gradient-to-b from-white/10 to-transparent rounded-2xl backdrop-blur-md shadow-2xl border border-white/20 group-hover:border-electric-purple/50 ring-1 ring-white/10 group-hover:ring-electric-purple/30 transition-all duration-500 group-hover:scale-110">
                        <span class="material-symbols-outlined text-electric-purple text-[64px] icon-hover-effect drop-shadow-[0_0_15px_rgba(189,0,255,0.6)]">school</span>
                    </div>
                    <h3 class="text-white text-4xl md:text-5xl font-bold mb-4 tracking-tight drop-shadow-xl font-display group-hover:text-electric-purple transition-colors duration-300">Burs Başvurusu</h3>
                    <p class="text-white/70 text-lg font-normal mb-8 group-hover:text-white/90 transition-colors">Eğitim hayatınızda yanınızdayız.</p>
                    <div class="flex items-center gap-2 text-white font-bold text-sm bg-white/5 px-8 py-4 rounded-xl backdrop-blur-md border border-white/10 group-hover:bg-electric-purple group-hover:text-white group-hover:border-electric-purple transition-all duration-300 shadow-lg">
                        <span>Başvuruya Git</span>
                        <span class="material-symbols-outlined text-lg group-hover:translate-x-1 transition-transform">arrow_forward</span>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Footer -->
    <footer class="w-full py-8 text-center text-white/30 text-xs font-medium relative z-10 mt-auto backdrop-blur-sm bg-black/20">
        <div class="max-w-4xl mx-auto px-4">
            <p class="tracking-widest uppercase">© 2024 Burs Otomasyonu Sistemi. Tüm hakları saklıdır.</p>
        </div>
    </footer>
</body>
</html>
