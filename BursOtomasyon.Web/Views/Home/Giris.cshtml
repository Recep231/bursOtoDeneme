@{
    ViewData["Title"] = "Giriş Yap";
}

<!DOCTYPE html>
<html class="light" lang="tr"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>🎓 Burs Otomasyonu</title>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700;800&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#4A00E0",
                        "secondary": "#8E2DE2",
                        "accent": "#C06FEF",
                        "glass-border": "rgba(255, 255, 255, 0.4)",
                    },
                    fontFamily: {
                        "display": ["Lexend", "sans-serif"],
                    },
                    borderRadius: {"DEFAULT": "0.5rem", "lg": "1rem", "xl": "1.5rem", "2xl": "2rem", "3xl": "2.5rem", "full": "9999px"},
                    animation: {
                        'float': 'float 6s ease-in-out infinite',
                        'float-delayed': 'float 7s ease-in-out infinite 2s',
                        'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'spin-slow': 'spin 12s linear infinite',
                        'pop-in': 'pop-in 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards',
                        'gradient-xy': 'gradient-xy 15s ease infinite',
                        'blob': 'blob 7s infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-20px)' },
                        },
                        'pop-in': {
                            '0%': { opacity: '0', transform: 'scale(0.9) translateY(20px)' },
                            '100%': { opacity: '1', transform: 'scale(1) translateY(0)' },
                        },
                        blob: {
                            '0%': { transform: 'translate(0px, 0px) scale(1)' },
                            '33%': { transform: 'translate(30px, -50px) scale(1.1)' },
                            '66%': { transform: 'translate(-20px, 20px) scale(0.9)' },
                            '100%': { transform: 'translate(0px, 0px) scale(1)' }
                        },
                        'gradient-xy': {
                            '0%, 100%': {
                                'background-size': '400% 400%',
                                'background-position': 'left center'
                            },
                            '50%': {
                                'background-size': '200% 200%',
                                'background-position': 'right center'
                            }
                        }
                    }
                },
            },
        }
    </script>
<style>
        .gradient-bg {
            background: linear-gradient(-45deg, #0f0c29, #302b63, #24243e, #4A00E0);
            background-size: 400% 400%;
            animation: gradient-bg-anim 15s ease infinite
        }
        @@keyframes gradient-bg-anim {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .neo-glass-panel {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-top: 1px solid rgba(255, 255, 255, 0.8);
            border-left: 1px solid rgba(255, 255, 255, 0.8);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25), 
                        0 0 15px rgba(255, 255, 255, 0.3) inset;
        }
        .liquid-input {
            background: rgba(255, 255, 255, 0.5);
            border: 2px solid transparent;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .liquid-input:hover {
            background: rgba(255, 255, 255, 0.8);
        }
        .liquid-input:focus {
            background: #ffffff;
            border-color: #8E2DE2;
            box-shadow: 0 0 0 4px rgba(142, 45, 226, 0.1), 0 0 20px rgba(142, 45, 226, 0.2);
            transform: translateY(-2px);
        }
        .btn-energy {
            background-size: 200% auto;
            transition: 0.5s;
        }
        .btn-energy:hover {
            background-position: right center; 
            box-shadow: 0 0 30px rgba(142, 45, 226, 0.6);
            transform: translateY(-2px);
        }
        .holo-link {
            position: relative;
            background: linear-gradient(90deg, #4A00E0, #C06FEF);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-size: 200% auto;
            transition: all 0.3s ease;
        }
        .holo-link:hover {
            background-position: right center;
            text-shadow: 0 0 8px rgba(192, 111, 239, 0.5);
        }.kinetic-ring {
            border: 2px solid rgba(255,255,255,0.3);
            border-top: 2px solid #fff;
            border-radius: 50%;
        }
        .kinetic-core {
            background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.8), rgba(255,255,255,0.1));
            backdrop-filter: blur(5px);
            box-shadow: 0 0 30px rgba(142, 45, 226, 0.4);
        }
    </style>
</head>
<body class="font-display antialiased text-gray-800 gradient-bg min-h-screen flex flex-col overflow-x-hidden">
<div class="fixed top-0 left-0 w-full h-full overflow-hidden pointer-events-none z-0">
<div class="absolute top-[-10%] left-[-10%] w-[40rem] h-[40rem] bg-purple-600 rounded-full mix-blend-overlay filter blur-[100px] opacity-40 animate-blob"></div>
<div class="absolute top-[20%] right-[-10%] w-[35rem] h-[35rem] bg-blue-600 rounded-full mix-blend-overlay filter blur-[100px] opacity-40 animate-blob animation-delay-2000"></div>
<div class="absolute bottom-[-20%] left-[20%] w-[45rem] h-[45rem] bg-pink-600 rounded-full mix-blend-overlay filter blur-[100px] opacity-40 animate-blob animation-delay-4000"></div>
</div>
<nav class="w-full bg-white/5 backdrop-blur-xl border-b border-white/10 px-6 py-4 sticky top-0 z-50 shadow-[0_4px_30px_rgba(0,0,0,0.1)]">
<div class="max-w-[1280px] mx-auto flex items-center justify-between">
<a href="/" class="flex items-center gap-3 group cursor-pointer">
<div class="size-10 rounded-xl bg-gradient-to-br from-[#4A00E0] to-[#8E2DE2] text-white flex items-center justify-center shadow-lg group-hover:shadow-purple-400/50 group-hover:scale-110 transition-all duration-300">
<span class="material-symbols-outlined text-[24px]">school</span>
</div>
<h2 class="text-white text-lg md:text-xl font-bold tracking-tight drop-shadow-md">Burs Yönetim Sistemi</h2>
</a>
<div class="hidden md:flex items-center gap-8">
<a class="text-white/80 hover:text-white transition-colors text-sm font-medium" href="/">Ana Sayfa</a>
<a class="text-white/80 hover:text-white transition-colors text-sm font-medium" href="/Home/Burslar">Burslar</a>
<a class="text-white/80 hover:text-white transition-colors text-sm font-medium" href="/Bagis/BagisYap">Bağışçılar</a>
<div class="flex gap-3">
<button class="flex items-center justify-center rounded-xl h-9 px-4 bg-white text-[#4A00E0] border border-transparent hover:bg-purple-50 text-sm font-bold transition-all shadow-md">Giriş Yap</button>
<a href="/Home/BasvuruYap" class="flex items-center justify-center rounded-xl h-9 px-4 bg-white/10 text-white border border-white/30 hover:bg-white/20 text-sm font-bold transition-all shadow-sm backdrop-blur-sm">Kayıt Ol</a>
</div>
</div>
</div>
</nav>
<main class="flex-grow flex items-center justify-center p-4 md:p-8 relative z-10">
<div class="neo-glass-panel w-full max-w-[1000px] rounded-[32px] overflow-hidden flex flex-col md:flex-row shadow-2xl animate-pop-in min-h-[600px]">
<div class="relative w-full md:w-5/12 bg-gradient-to-br from-[#4A00E0]/80 to-[#8E2DE2]/80 backdrop-blur-md flex flex-col items-center justify-center p-8 md:p-12 overflow-hidden">
<div class="absolute inset-0 z-0">
<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] kinetic-ring animate-spin-slow opacity-30"></div>
<div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[200px] h-[200px] kinetic-ring animate-spin-slow opacity-50" style="animation-direction: reverse; border-color: rgba(255,255,255,0.5);"></div>
</div>
<div class="relative z-10 flex flex-col items-center text-center space-y-6">
<div class="w-32 h-32 rounded-full kinetic-core flex items-center justify-center mb-4 animate-float">
<span class="material-symbols-outlined text-6xl text-white drop-shadow-[0_0_15px_rgba(255,255,255,0.8)]">admin_panel_settings</span>
</div>
<h2 class="text-3xl font-black text-white tracking-tight drop-shadow-lg">Güvenli Erişim</h2>
<p class="text-white/80 font-medium leading-relaxed">
                        Geleceğini şekillendirmek için güvenli kapıdan içeri adım at. Burs başvurularını yönetmek artık çok daha kolay.
                    </p>
<div class="absolute -bottom-12 -left-12 w-24 h-24 bg-pink-500/30 rounded-full blur-xl animate-pulse-slow"></div>
<div class="absolute top-12 right-6 w-16 h-16 bg-blue-400/30 rounded-full blur-xl animate-float-delayed"></div>
</div>
</div>
<div class="w-full md:w-7/12 p-8 md:p-12 bg-white/40 flex flex-col justify-center">
<div class="mb-8">
<h1 class="text-3xl md:text-4xl font-extrabold text-gray-800 mb-2">Hoş Geldiniz <span class="text-[#4A00E0]">👋</span></h1>
<p class="text-gray-500 font-medium">Hesabınıza giriş yaparak işlemlerinize devam edin.</p>
</div>
<form class="space-y-6">
<div class="group">
<label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2 ml-1">E-Posta veya Kullanıcı Adı</label>
<div class="relative">
<div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
<span class="material-symbols-outlined text-gray-400 group-focus-within:text-[#4A00E0] transition-colors">person</span>
</div>
<input class="w-full pl-12 pr-4 py-4 rounded-2xl liquid-input text-gray-700 placeholder-gray-400 font-medium focus:outline-none" placeholder="ornek@ogrenci.edu.tr" type="text"/>
</div>
</div>
<div class="group">
<label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2 ml-1">Şifre</label>
<div class="relative">
<div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
<span class="material-symbols-outlined text-gray-400 group-focus-within:text-[#4A00E0] transition-colors">lock</span>
</div>
<input class="w-full pl-12 pr-12 py-4 rounded-2xl liquid-input text-gray-700 placeholder-gray-400 font-medium focus:outline-none" placeholder="••••••••" type="password" id="passwordInput"/>
<button class="absolute inset-y-0 right-0 pr-4 flex items-center cursor-pointer text-gray-400 hover:text-gray-600 transition-colors" type="button" onclick="togglePassword()">
<span class="material-symbols-outlined text-[20px]" id="passwordToggle">visibility</span>
</button>
</div>
</div>
<div class="flex items-center justify-between text-sm">
<label class="flex items-center gap-2 cursor-pointer group/check">
<div class="relative flex items-center">
<input class="peer h-5 w-5 cursor-pointer appearance-none rounded-md border-2 border-gray-300 bg-white/50 checked:bg-[#4A00E0] checked:border-transparent focus:ring-0 transition-all shadow-sm" type="checkbox"/>
<span class="material-symbols-outlined absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-[14px] text-white opacity-0 peer-checked:opacity-100 transition-opacity pointer-events-none">check</span>
</div>
<span class="text-gray-600 font-semibold group-hover/check:text-gray-800 transition-colors">Beni Hatırla</span>
</label>
<a class="font-bold text-sm holo-link flex items-center gap-1 group" href="#">
                            Şifremi Unuttum?
                        </a>
</div>
<button class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-[#4A00E0] via-[#8E2DE2] to-[#4A00E0] text-white font-bold text-lg shadow-xl shadow-purple-500/30 btn-energy relative overflow-hidden group" type="button">
<span class="relative z-10 flex items-center justify-center gap-2">
                            Giriş Yap
                            <span class="material-symbols-outlined group-hover:rotate-180 transition-transform duration-500">login</span>
</span>
</button>
<div class="relative flex py-2 items-center">
<div class="flex-grow border-t border-gray-300/50"></div>
<span class="flex-shrink-0 mx-4 text-gray-400 text-sm font-medium">veya</span>
<div class="flex-grow border-t border-gray-300/50"></div>
</div>
<div class="text-center">
<p class="text-gray-600 font-medium">
                            Hesabın yok mu? 
                            <a class="font-bold ml-1 holo-link inline-flex items-center gap-1" href="/Home/BasvuruYap">
                                Hemen Kayıt Ol
                                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</a>
</p>
</div>
</form>
</div>
</div>
</main>
<footer class="bg-black/20 backdrop-blur-md border-t border-white/10 py-6 relative z-10 text-white mt-auto">
<div class="max-w-[1280px] mx-auto px-8 text-center flex flex-col md:flex-row items-center justify-between gap-4">
<p class="text-white/60 text-sm font-medium">© 2024 Öğrenci Burs Yönetim Sistemi. Tüm hakları saklıdır.</p>
<div class="flex gap-6">
<a class="text-white/60 hover:text-white text-sm transition-colors" href="#">Gizlilik</a>
<a class="text-white/60 hover:text-white text-sm transition-colors" href="#">Kullanım Şartları</a>
<a class="text-white/60 hover:text-white text-sm transition-colors" href="#">Yardım</a>
</div>
</div>
</footer>

<script>
    function togglePassword() {
        const passwordInput = document.getElementById('passwordInput');
        const passwordToggle = document.getElementById('passwordToggle');
        
        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            passwordToggle.textContent = 'visibility_off';
        } else {
            passwordInput.type = 'password';
            passwordToggle.textContent = 'visibility';
        }
    }
</script>

</body></html>

