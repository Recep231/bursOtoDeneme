@model BursOtomasyon.Web.Models.BagisViewModel
@{
    ViewData["Title"] = "Bağış Yap";
}

<!DOCTYPE html>
<html class="light" lang="tr">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] - Öğrenci Burs Yönetim Sistemi</title>
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect" />
    <link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#4A00E0", 
                        "secondary": "#8E2DE2",
                        "background-light": "#f6f6f8",
                        "background-dark": "#101022",
                    },
                    fontFamily: {
                        "display": ["Lexend", "Segoe UI", "sans-serif"]
                    },
                    borderRadius: {"DEFAULT": "0.5rem", "lg": "1rem", "xl": "1.5rem", "full": "9999px"},
                    animation: {
                        'gradient-xy': 'gradient-xy 15s ease infinite',
                        'float-up': 'floatUp 4s linear forwards',
                    },
                    keyframes: {
                        'gradient-xy': {
                            '0%, 100%': {
                                'background-size': '200% 200%',
                                'background-position': 'left center'
                            },
                            '50%': {
                                'background-size': '200% 200%',
                                'background-position': 'right center'
                            }
                        }
                    }
                },
            },
        }
    </script>
    <style>
        body {
            font-family: 'Lexend', 'Segoe UI', sans-serif;
        }
        .bg-gradient-animated {
            background: linear-gradient(-45deg, #4A00E0, #8E2DE2, #240b36, #16A085);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
        }
        @@keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .bg-gradient-green {
            background: linear-gradient(135deg, #16A085 0%, #2ECC71 100%);
        }
        .glass-card {
            background: rgba(255, 255, 255, 0.90);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.8);
            box-shadow: 0 20px 50px -12px rgba(0, 0, 0, 0.25);
        }
        .input-minimal {
            background-color: rgba(255, 255, 255, 0.7);
            border: 1px solid #e2e8f0;
            transition: all 0.3s ease;
        }
        .input-minimal:focus {
            background-color: #ffffff;
            border-color: #8E2DE2;
            box-shadow: 0 0 0 4px rgba(142, 45, 226, 0.1);
        }
        input[type=range] {
            -webkit-appearance: none; 
            background: transparent; 
        }
        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            height: 24px;
            width: 24px;
            border-radius: 50%;
            background: #8E2DE2;
            cursor: pointer;
            margin-top: -10px; 
            box-shadow: 0 0 0 4px rgba(142, 45, 226, 0.2);
            transition: transform 0.1s;
        }
        input[type=range]::-webkit-slider-thumb:hover {
            transform: scale(1.1);
        }
        input[type=range]::-webkit-slider-runnable-track {
            width: 100%;
            height: 6px;
            cursor: pointer;
            background: #ddd;
            border-radius: 10px;
        }
        input[type=range]:focus::-webkit-slider-runnable-track {
            background: #ccc;
        }
        @@keyframes float {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
            100% { transform: translateY(0px); }
        }
        @@keyframes floatUp {
            0% { transform: translateY(100vh) rotate(0deg); opacity: 1; }
            100% { transform: translateY(-20vh) rotate(360deg); opacity: 0; }
        }
        .animate-float {
            animation: float 6s ease-in-out infinite;
        }
        .animate-float-delayed {
            animation: float 7s ease-in-out infinite 2s;
        }
        @@keyframes flyOut {
            0% { transform: translateY(0) scale(1); opacity: 1; }
            50% { transform: translateY(-20px) scale(1.1); opacity: 0.8; }
            100% { transform: translateY(-40px) scale(0.5); opacity: 0; }
        }
        .fly-animation {
            animation: flyOut 0.8s ease-out forwards;
            position: absolute;
            pointer-events: none;
            color: #16A085;
            font-weight: bold;
        }
    </style>
</head>
<body class="flex flex-col min-h-screen bg-background-light dark:bg-background-dark overflow-x-hidden font-display">
    <!-- Header -->
    <header class="sticky top-0 z-50 flex items-center justify-between whitespace-nowrap border-b border-solid border-b-[#f0f0f4] bg-white/95 backdrop-blur-md px-10 py-3 shadow-sm">
        <a href="/" class="flex items-center gap-4 text-[#111118]">
            <div class="size-8 text-primary">
                <span class="material-symbols-outlined text-3xl">school</span>
            </div>
            <h2 class="text-[#111118] text-lg font-bold leading-tight tracking-[-0.015em]">Öğrenci Burs Yönetim Sistemi</h2>
        </a>
        <div class="hidden md:flex flex-1 justify-end gap-8">
            <nav class="flex items-center gap-9">
                <a class="text-[#111118] hover:text-primary transition-colors text-sm font-medium leading-normal" href="/">Ana Sayfa</a>
                <a class="text-[#111118] hover:text-primary transition-colors text-sm font-medium leading-normal" href="/Home/BasvuruYap">Burs Başvurusu</a>
                <a class="text-primary text-sm font-bold leading-normal" href="/Bagis/BagisYap">Bağış Yap</a>
            </nav>
        </div>
        <div class="md:hidden flex items-center">
            <span class="material-symbols-outlined cursor-pointer text-[#111118]">menu</span>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow flex items-center justify-center py-12 px-4 bg-gradient-animated relative w-full overflow-hidden">
        <!-- Decorative Elements -->
        <div class="absolute top-[10%] left-[5%] text-white/10 animate-float pointer-events-none">
            <span class="material-symbols-outlined text-[150px]">favorite</span>
        </div>
        <div class="absolute top-[40%] right-[10%] text-white/10 animate-float-delayed pointer-events-none">
            <span class="material-symbols-outlined text-[100px]">volunteer_activism</span>
        </div>
        <div class="absolute bottom-[10%] left-[20%] w-64 h-64 bg-white/10 rounded-full blur-3xl pointer-events-none animate-pulse"></div>
        <div class="absolute top-[20%] right-[30%] w-48 h-48 bg-purple-300/20 rounded-full blur-2xl pointer-events-none"></div>
        <div class="absolute top-5 left-1/2 w-2 h-2 bg-white/40 rounded-full animate-ping"></div>
        <div class="absolute bottom-20 right-20 w-3 h-3 bg-white/30 rounded-full animate-bounce"></div>

        <!-- Main Card -->
        <div class="relative glass-card w-full max-w-[850px] rounded-3xl overflow-hidden shadow-2xl z-10 transition-all duration-500">
            <!-- Progress Bar -->
            <div class="w-full bg-gray-100 h-2 relative overflow-hidden group">
                <div class="h-full bg-gradient-to-r from-primary to-secondary w-[65%] rounded-r-full relative">
                    <div class="absolute right-0 top-0 h-full w-full animate-[shimmer_2s_infinite] bg-gradient-to-r from-transparent via-white/30 to-transparent -translate-x-full"></div>
                </div>
                <div class="absolute top-3 left-4 text-[10px] text-gray-500 font-medium tracking-wider opacity-0 group-hover:opacity-100 transition-opacity">
                    HEDEF: ₺1,000,000
                </div>
                <div class="absolute top-3 right-4 text-[10px] text-primary font-bold tracking-wider opacity-0 group-hover:opacity-100 transition-opacity">
                    %65 TAMAMLANDI
                </div>
            </div>

            <!-- Header Section -->
            <div class="p-8 pb-4 text-center">
                <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gradient-to-br from-indigo-50 to-purple-100 text-primary mb-6 shadow-md ring-4 ring-white">
                    <span class="material-symbols-outlined text-5xl">volunteer_activism</span>
                </div>
                <h1 class="text-[#111118] text-3xl md:text-5xl font-bold leading-tight mb-3 tracking-tight">Geleceğe Işık Ol</h1>
                <p class="text-[#4a4a6a] text-lg font-normal max-w-lg mx-auto leading-relaxed">
                    Her bağış bir öğrencinin hayallerine açılan kapıdır. Desteğinizle yarınları aydınlatın.
                </p>
            </div>

            <!-- Alerts -->
            @if (ViewBag.Success != null && ViewBag.Success)
            {
                <div class="mx-8 mb-4 bg-emerald-50 border border-emerald-200 text-emerald-800 px-6 py-4 rounded-2xl flex items-center gap-4">
                    <span class="material-symbols-outlined text-emerald-600 text-3xl">check_circle</span>
                    <div>
                        <strong class="font-bold block">Teşekkürler!</strong>
                        <span class="text-sm">@ViewBag.Message</span>
                    </div>
            </div>
        }

        @if (ViewBag.Error != null)
        {
                <div class="mx-8 mb-4 bg-red-50 border border-red-200 text-red-800 px-6 py-4 rounded-2xl flex items-center gap-4">
                    <span class="material-symbols-outlined text-red-600 text-3xl">error</span>
                    <div>
                        <strong class="font-bold block">Hata!</strong>
                        <span class="text-sm">@ViewBag.Error</span>
                    </div>
            </div>
        }

            <!-- Form -->
            <form asp-action="BagisYap" method="post" class="p-8 pt-4 md:p-12 md:pt-6 space-y-8">
                <!-- Amount Section -->
                <div class="flex flex-col items-center justify-center space-y-6 bg-white/60 backdrop-blur-sm p-8 rounded-3xl border border-white shadow-lg relative overflow-hidden">
                    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-primary/20 to-transparent"></div>
                    <label class="text-[#111118] text-lg font-bold tracking-wide uppercase text-xs text-primary">Bağış Tutarı</label>
                    
                    <div class="flex items-center justify-center gap-4 w-full max-w-lg relative">
                        <button class="w-12 h-12 rounded-2xl bg-white shadow-md border border-gray-100 flex items-center justify-center text-gray-400 hover:text-primary hover:border-primary hover:shadow-lg transition-all active:scale-95 z-10" onclick="updateAmount(-50)" type="button">
                            <span class="material-symbols-outlined">remove</span>
                        </button>
                        <div class="relative flex-1 text-center group">
                            <span class="absolute left-[15%] top-1/2 -translate-y-1/2 text-4xl font-bold text-gray-300 pointer-events-none transition-colors group-focus-within:text-primary/50">₺</span>
                            <input asp-for="Tutar" class="w-full text-center text-7xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary outline-none py-2 placeholder:text-gray-200 tracking-tighter" id="amountInput" min="1" oninput="calculateImpact(this.value); updateSlider(this.value);" placeholder="0" required="" value="500" />
                        </div>
                        <button class="w-12 h-12 rounded-2xl bg-white shadow-md border border-gray-100 flex items-center justify-center text-gray-400 hover:text-primary hover:border-primary hover:shadow-lg transition-all active:scale-95 z-10" onclick="updateAmount(50)" type="button">
                            <span class="material-symbols-outlined">add</span>
                        </button>
                    </div>
                    
                    <div class="w-full max-w-md px-4">
                        <input class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer" id="amountSlider" max="5000" min="0" oninput="setAmount(this.value)" step="50" type="range" value="500" />
                        <div class="flex justify-between text-xs text-gray-400 mt-2 font-medium">
                            <span>0₺</span>
                            <span>5000₺+</span>
                        </div>
        </div>
        
                    <div class="bg-indigo-50 border border-indigo-100 text-indigo-800 px-6 py-3 rounded-full text-sm font-medium flex items-center gap-2 animate-pulse transition-all duration-300 transform" id="impactContainer">
                        <span class="material-symbols-outlined text-lg">school</span>
                        <span id="impactText">1 Öğrencinin yemek bursuna destek oluyorsunuz!</span>
                    </div>
                    
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-2 w-full max-w-lg">
                        <button class="py-2.5 rounded-xl border border-indigo-100 bg-white text-sm font-semibold text-gray-600 hover:bg-primary hover:text-white hover:border-primary transition-all shadow-sm hover:shadow-md" onclick="setAmount(100)" type="button">100₺</button>
                        <button class="py-2.5 rounded-xl border border-indigo-100 bg-white text-sm font-semibold text-gray-600 hover:bg-primary hover:text-white hover:border-primary transition-all shadow-sm hover:shadow-md" onclick="setAmount(250)" type="button">250₺</button>
                        <button class="py-2.5 rounded-xl border border-indigo-100 bg-white text-sm font-semibold text-gray-600 hover:bg-primary hover:text-white hover:border-primary transition-all shadow-sm hover:shadow-md" onclick="setAmount(500)" type="button">500₺</button>
                        <button class="py-2.5 rounded-xl border border-indigo-100 bg-white text-sm font-semibold text-gray-600 hover:bg-primary hover:text-white hover:border-primary transition-all shadow-sm hover:shadow-md" onclick="setAmount(1000)" type="button">1000₺</button>
                    </div>
                    <span asp-validation-for="Tutar" class="text-red-500 text-sm"></span>
                </div>

                <!-- Personal Info Section -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="flex flex-col gap-2 group">
                        <label class="text-[#333] text-sm font-semibold ml-1" asp-for="Ad">Ad *</label>
                        <input asp-for="Ad" class="input-minimal w-full rounded-xl h-12 px-4 text-base placeholder:text-gray-400 text-gray-800" placeholder="Adınız" required="" />
                        <span asp-validation-for="Ad" class="text-red-500 text-sm"></span>
                    </div>
                    <div class="flex flex-col gap-2 group">
                        <label class="text-[#333] text-sm font-semibold ml-1" asp-for="Soyad">Soyad *</label>
                        <input asp-for="Soyad" class="input-minimal w-full rounded-xl h-12 px-4 text-base placeholder:text-gray-400 text-gray-800" placeholder="Soyadınız" required="" />
                        <span asp-validation-for="Soyad" class="text-red-500 text-sm"></span>
                    </div>
                    <div class="flex flex-col gap-2 md:col-span-2 group">
                        <label class="text-[#333] text-sm font-semibold ml-1" asp-for="Email">E-posta *</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-4 top-3 text-gray-400 group-focus-within:text-primary transition-colors">mail</span>
                            <input asp-for="Email" type="email" class="input-minimal w-full rounded-xl h-12 pl-12 pr-4 text-base placeholder:text-gray-400 text-gray-800" placeholder="ornek@email.com" required="" />
                        </div>
                        <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
                    </div>
                    <div class="flex flex-col gap-2 md:col-span-2 group">
                        <label class="text-[#333] text-sm font-semibold ml-1" asp-for="Telefon">Telefon</label>
                        <div class="relative">
                            <span class="material-symbols-outlined absolute left-4 top-3 text-gray-400 group-focus-within:text-primary transition-colors">call</span>
                            <input asp-for="Telefon" type="tel" class="input-minimal w-full rounded-xl h-12 pl-12 pr-4 text-base placeholder:text-gray-400 text-gray-800" id="phoneInput" placeholder="0 (5XX) XXX XX XX" />
                        </div>
                        <span asp-validation-for="Telefon" class="text-red-500 text-sm"></span>
                    </div>
                    <div class="flex flex-col gap-2 md:col-span-2 group">
                        <label class="text-[#333] text-sm font-semibold ml-1" asp-for="Aciklama">Açıklama (İsteğe Bağlı)</label>
                        <textarea asp-for="Aciklama" class="input-minimal w-full rounded-xl px-4 py-3 text-base placeholder:text-gray-400 text-gray-800 resize-none" rows="3" placeholder="Bağışınızla ilgili bir mesaj yazabilirsiniz..."></textarea>
                    </div>
            </div>

                <!-- IBAN Section -->
                <div class="bg-gradient-to-r from-gray-50 to-white p-6 rounded-2xl border border-gray-200 flex flex-col md:flex-row items-center md:justify-between gap-6 shadow-sm group hover:shadow-lg transition-all relative overflow-hidden">
                    <div class="absolute right-0 top-0 opacity-5 pointer-events-none">
                        <span class="material-symbols-outlined text-9xl">account_balance</span>
                    </div>
                    <div class="flex items-center gap-5 relative z-10">
                        <div class="bg-white p-4 rounded-2xl shadow-sm shrink-0 text-primary border border-gray-100">
                            <span class="material-symbols-outlined text-3xl">account_balance_wallet</span>
                        </div>
                        <div class="text-center md:text-left">
                            <h3 class="text-gray-500 font-bold text-xs uppercase tracking-wider mb-1">Banka Hesap Bilgileri</h3>
                            <p class="text-[#111118] font-mono font-bold text-lg md:text-xl tracking-wide" id="ibanText">TR00 0000 0000 0000 0000 0000 00</p>
                        </div>
                    </div>
                    <div class="relative z-10">
                        <button class="px-6 py-3 bg-white hover:bg-primary hover:text-white text-gray-700 border border-gray-200 rounded-xl shadow-sm flex items-center gap-2 transition-all active:scale-95 group-hover:border-primary/30" onclick="copyIBAN(this)" type="button">
                            <span class="material-symbols-outlined text-xl" id="copyIcon">content_copy</span>
                            <span class="font-bold text-sm" id="copyLabel">Kopyala</span>
                        </button>
                        <div class="absolute -top-12 left-1/2 -translate-x-1/2 bg-black text-white text-xs py-1 px-3 rounded shadow-lg opacity-0 transition-opacity pointer-events-none" id="copyTooltip">
                            Kopyalandı!
                        </div>
                </div>
            </div>

                <!-- Submit Button -->
                <button class="w-full h-16 rounded-2xl bg-gradient-green text-white text-xl font-bold shadow-lg shadow-green-500/30 hover:shadow-green-500/50 hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 flex items-center justify-center gap-3 group overflow-hidden relative" type="submit">
                    <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300 rounded-2xl"></div>
                    <span class="relative z-10 flex items-center gap-2">
                        💝 Bağış Yap
                        <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">arrow_forward</span>
                    </span>
                </button>
                
                <p class="text-center text-xs text-gray-500 flex items-center justify-center gap-1">
                    <span class="material-symbols-outlined text-sm">lock</span>
                    256-bit SSL ile güvenli ödeme altyapısı.
                </p>
            </form>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-[#f0f0f4] py-8 px-10 relative z-10">
        <div class="max-w-[960px] mx-auto flex flex-col md:flex-row justify-between items-center gap-6">
            <div class="flex items-center gap-2 text-[#111118]">
                <span class="material-symbols-outlined text-primary">school</span>
                <span class="font-bold">Öğrenci Burs Yönetim Sistemi</span>
            </div>
            <p class="text-[#616189] text-sm">© 2024 Tüm Hakları Saklıdır.</p>
        </div>
    </footer>

    <!-- Success Modal -->
    <div class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/80 backdrop-blur-md transition-opacity opacity-0" id="successModal">
        <div class="absolute inset-0 overflow-hidden pointer-events-none" id="particles-container"></div>
        <div class="bg-white rounded-[2rem] p-10 max-w-sm w-full mx-4 shadow-2xl text-center transform scale-90 transition-transform duration-500 relative overflow-hidden" id="modalContent">
            <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-green-400 to-emerald-600"></div>
            <div class="absolute -top-10 -right-10 w-32 h-32 bg-yellow-100 rounded-full blur-2xl opacity-50"></div>
            <div class="relative z-10">
                <div class="w-28 h-28 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-6 ring-4 ring-green-100 animate-bounce">
                    <span class="material-symbols-outlined text-6xl text-transparent bg-clip-text bg-gradient-to-br from-green-500 to-emerald-700">volunteer_activism</span>
                </div>
                <h3 class="text-3xl font-bold text-[#111118] mb-2 animate-pulse">Teşekkürler!</h3>
                <p class="text-[#616189] mb-8 text-lg">Bağışınızla bir geleceği aydınlattınız.<br /> <span class="text-emerald-600 font-bold text-2xl mt-3 inline-block bg-emerald-50 px-4 py-1 rounded-lg border border-emerald-100"><span id="successAmount">0</span> TL</span></p>
                <button class="w-full py-4 rounded-xl bg-gradient-green text-white text-lg font-bold hover:shadow-xl hover:shadow-green-500/40 transition-all active:scale-95 flex items-center justify-center gap-2" onclick="closeModal()">
                    Harika!
                    <span class="material-symbols-outlined">thumb_up</span>
                </button>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        // Initialize impact on load
        document.addEventListener('DOMContentLoaded', () => {
            calculateImpact(500);
        });

        // Phone formatting
        const phoneInput = document.getElementById('phoneInput');
        if (phoneInput) {
            phoneInput.addEventListener('input', function (e) {
                let numbers = e.target.value.replace(/\D/g, '');
                if (numbers.length > 11) numbers = numbers.substring(0, 11);
                
                let formatted = '';
                if (numbers.length > 0) {
                    formatted = numbers.charAt(0);
                    if (numbers.length > 1) {
                        formatted += ' (' + numbers.substring(1, Math.min(4, numbers.length));
                        if (numbers.length > 4) {
                            formatted += ') ' + numbers.substring(4, Math.min(7, numbers.length));
                            if (numbers.length > 7) {
                                formatted += ' ' + numbers.substring(7, Math.min(9, numbers.length));
                                if (numbers.length > 9) {
                                    formatted += ' ' + numbers.substring(9, 11);
                                }
                            }
                        } else if (numbers.length > 1) {
                            formatted += ')';
                        }
                    }
                }
                e.target.value = formatted;
            });
        }

        // Set amount from chips
        function setAmount(val) {
            document.getElementById('amountInput').value = val;
            document.getElementById('amountSlider').value = val;
            calculateImpact(val);
        }

        // Update slider visually
        function updateSlider(val) {
            document.getElementById('amountSlider').value = val;
        }

        // Update amount with +/- buttons
        function updateAmount(change) {
            const input = document.getElementById('amountInput');
            let val = parseInt(input.value) || 0;
            val += change;
            if (val < 0) val = 0;
            input.value = val;
            document.getElementById('amountSlider').value = val;
            calculateImpact(val);
        }

        // Calculate and show impact
        function calculateImpact(amount) {
            const impactContainer = document.getElementById('impactContainer');
            const val = parseInt(amount) || 0;
            
            let message = "";
            let icon = "school";
            
            if (val >= 5000) {
                message = "Harika! Bir öğrencinin yıllık eğitim ihtiyacını karşılıyorsunuz!";
                icon = "workspace_premium";
                impactContainer.className = "bg-purple-50 border border-purple-100 text-purple-800 px-6 py-3 rounded-full text-sm font-medium flex items-center gap-2 animate-pulse transition-all duration-300 transform";
            } else if (val >= 1000) {
                const students = Math.floor(val / 500);
                message = `${students} Öğrencinin aylık yemek bursuna destek oluyorsunuz!`;
                icon = "restaurant";
                impactContainer.className = "bg-indigo-50 border border-indigo-100 text-indigo-800 px-6 py-3 rounded-full text-sm font-medium flex items-center gap-2 transition-all duration-300 transform";
            } else if (val >= 250) {
                message = "Bir öğrencinin aylık yol masrafına destek oldunuz.";
                icon = "directions_bus";
                impactContainer.className = "bg-blue-50 border border-blue-100 text-blue-800 px-6 py-3 rounded-full text-sm font-medium flex items-center gap-2 transition-all duration-300 transform";
            } else if (val > 0) {
                message = "Öğrencilerimiz için kırtasiye desteği sağladınız.";
                icon = "menu_book";
                impactContainer.className = "bg-green-50 border border-green-100 text-green-800 px-6 py-3 rounded-full text-sm font-medium flex items-center gap-2 transition-all duration-300 transform";
            } else {
                message = "Bağış tutarı giriniz.";
                icon = "volunteer_activism";
            }
            
            impactContainer.innerHTML = `<span class="material-symbols-outlined text-lg">${icon}</span> <span id="impactText">${message}</span>`;
        }

        // Copy IBAN Functionality
        function copyIBAN(btnElement) {
            const iban = document.getElementById('ibanText').innerText;
            navigator.clipboard.writeText(iban).then(() => {
                const icon = document.getElementById('copyIcon');
                const label = document.getElementById('copyLabel');
                
                const originalIcon = icon.innerText;
                const originalLabel = label.innerText;
                
                icon.innerText = 'check_circle';
                label.innerText = 'Kopyalandı';
                icon.classList.add('text-green-600');
                label.classList.add('text-green-600');
                
                // Create Flying Element
                const flyer = document.createElement('div');
                flyer.innerText = iban.replace(/\s/g, '').substring(0, 6) + '...';
                flyer.classList.add('fly-animation');
                const rect = btnElement.getBoundingClientRect();
                flyer.style.left = (rect.left + rect.width / 2) + 'px';
                flyer.style.top = rect.top + 'px';
                document.body.appendChild(flyer);
                
                setTimeout(() => {
                    flyer.remove();
                }, 1000);
                
                setTimeout(() => {
                    icon.innerText = originalIcon;
                    label.innerText = originalLabel;
                    icon.classList.remove('text-green-600');
                    label.classList.remove('text-green-600');
                }, 2000);
            });
        }

        // Modal Logic & Particles
        const modal = document.getElementById('successModal');
        const modalContent = document.getElementById('modalContent');

        function createParticles() {
            const container = document.getElementById('particles-container');
            container.innerHTML = '';
            const symbols = ['💝', '✨', '🎓', '🌟', '💛'];
            const colors = ['#FFD700', '#FF69B4', '#4A00E0', '#2ECC71'];
            
            for (let i = 0; i < 40; i++) {
                const p = document.createElement('div');
                p.innerText = symbols[Math.floor(Math.random() * symbols.length)];
                p.style.position = 'absolute';
                p.style.left = Math.random() * 100 + '%';
                p.style.top = '110%';
                p.style.fontSize = (Math.random() * 24 + 10) + 'px';
                p.style.color = colors[Math.floor(Math.random() * colors.length)];
                p.style.textShadow = '0 0 5px rgba(255,255,255,0.5)';
                
                const duration = Math.random() * 3 + 2;
                const delay = Math.random() * 2;
                p.style.animation = `floatUp ${duration}s linear forwards`;
                p.style.animationDelay = `${delay}s`;
                container.appendChild(p);
            }
        }

        function showSuccessMessage() {
            const amount = document.getElementById('amountInput').value;
            if (!amount || amount <= 0) return;
            
            document.getElementById('successAmount').innerText = amount;
            modal.classList.remove('hidden');
            void modal.offsetWidth;
            modal.classList.remove('opacity-0');
            modalContent.classList.remove('scale-90');
            modalContent.classList.add('scale-100');
            createParticles();
        }

        function closeModal() {
            modal.classList.add('opacity-0');
            modalContent.classList.remove('scale-100');
            modalContent.classList.add('scale-90');
            setTimeout(() => {
                modal.classList.add('hidden');
                document.getElementById('particles-container').innerHTML = '';
            }, 300);
        }

        // Show success modal if form was submitted successfully
        @if (ViewBag.Success != null && ViewBag.Success)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                const amount = document.getElementById('amountInput').value || '@Model.Tutar';
                if (amount) {
                    document.getElementById('successAmount').innerText = amount;
                    modal.classList.remove('hidden');
                    void modal.offsetWidth;
                    modal.classList.remove('opacity-0');
                    modalContent.classList.remove('scale-90');
                    modalContent.classList.add('scale-100');
                    createParticles();
                }
            });
            </text>
        }
    </script>
</body>
</html>
